// ============================================================
// ERD SOAL 1.1 - GENERAL LEDGER MODULE
// UTS Coding Akuntansi - FEB Undip
// ============================================================
// Skema: chart_of_accounts, journal_headers, journal_lines
//
// Kardinalitas:
//   chart_of_accounts (1) ──< (N) journal_lines
//   journal_headers   (1) ──< (N) journal_lines
// ============================================================

// ------------------------------------------------------------
// TABEL 1: MASTER AKUN (Chart of Accounts)
// ------------------------------------------------------------
Table chart_of_accounts {
  account_id            varchar(10) [pk, note: 'Kode akun (misal: 101, 101.1, 1-1000)']
  account_name          varchar(100) [not null, note: 'Nama akun (misal: Kas, Piutang Usaha)']
  normal_balance        varchar(6) [not null, note: 'Tipe saldo normal: DEBIT atau CREDIT']
  report_classification varchar(20) [not null, note: 'Klasifikasi: ASET, LIABILITAS, EKUITAS, PENDAPATAN, BEBAN']

  Note: 'Master data akun (Chart of Accounts). PK pakai VARCHAR karena kode akun bersifat semantik/bermakna.'

  indexes {
    report_classification [name: 'idx_coa_classification']
  }
}

// ------------------------------------------------------------
// TABEL 2: HEADER TRANSAKSI JURNAL
// ------------------------------------------------------------
Table journal_headers {
  header_id      serial [pk, note: 'ID auto-increment']
  trx_date       date [not null, note: 'Tanggal transaksi']
  reference_no   varchar(30) [unique, note: 'Nomor bukti/referensi (misal: JV-2026-0001)']
  description    text [note: 'Deskripsi transaksi']
  status_posting varchar(10) [not null, default: 'DRAFT', note: 'Status: DRAFT, POSTED, atau VOID']

  Note: 'Kepala transaksi jurnal. 1 baris = 1 transaksi. Menyimpan metadata transaksi.'

  indexes {
    trx_date [name: 'idx_jh_date']
    status_posting [name: 'idx_jh_status']
  }
}

// ------------------------------------------------------------
// TABEL 3: DETAIL BARIS JURNAL (Junction Table)
// ------------------------------------------------------------
Table journal_lines {
  line_id    serial [pk, note: 'ID auto-increment']
  header_id  int [not null, ref: > journal_headers.header_id, note: 'FK ke journal_headers']
  account_id varchar(10) [not null, ref: > chart_of_accounts.account_id, note: 'FK ke chart_of_accounts']
  debit      numeric(15,2) [not null, default: 0, note: 'Nominal debit (>= 0)']
  credit     numeric(15,2) [not null, default: 0, note: 'Nominal kredit (>= 0)']

  Note: 'Detail baris jurnal. Junction table penghubung header dengan akun. Minimal 2 baris per transaksi (double-entry).'

  indexes {
    (header_id, account_id) [name: 'idx_jl_header_account']
  }
}

// ============================================================
// CATATAN RELASI:
// ============================================================
// 1. chart_of_accounts (1) ──< (N) journal_lines
//    Satu akun bisa muncul di banyak baris jurnal.
//    Satu baris jurnal hanya merujuk ke satu akun.
//
// 2. journal_headers (1) ──< (N) journal_lines
//    Satu header punya banyak baris (minimal 2: debit + kredit).
//    Satu baris jurnal hanya milik satu header.
//
// 3. chart_of_accounts dan journal_headers TIDAK berelasi langsung.
//    Hubungan keduanya melalui journal_lines (junction table).
// ============================================================